<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs tools/refresh_data.sh every Monday at 06:00 (or at the next wake if the Mac was asleep).
  Install:   cp tools/com.tfgm-map.refresh.plist ~/Library/LaunchAgents/
             launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.tfgm-map.refresh.plist
  Run now:   launchctl kickstart gui/$(id -u)/com.tfgm-map.refresh
  Remove:    launchctl bootout gui/$(id -u)/com.tfgm-map.refresh
             rm ~/Library/LaunchAgents/com.tfgm-map.refresh.plist
  Log:       ~/Library/Logs/tfgm-map-refresh.log
  REPO_PATH below is replaced with this folder's path when installed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tfgm-map.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPO_PATH/tools/refresh_data.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>LOG_PATH</string>
  <key>StandardErrorPath</key>
  <string>LOG_PATH</string>
</dict>
</plist>
